{
  "expo": {
    "name": "ريحان",
    "slug": "rayhan",
    "owner": "rayhan-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rayhan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.rayhanai.app",
      "supportsTablet": false,
      "infoPlist": {
        "ExpoLocalization_supportsRTL": true,
        "ExpoLocalization_forcesRTL": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "package": "com.rayhanai.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F2EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#1A1917"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج ريحان إلى الوصول إلى صورك لاختيار صور المستندات وإرفاقها في المحادثة.",
          "cameraPermission": "يحتاج ريحان إلى الكاميرا لتصوير المستندات وإرفاقها في المحادثة.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "./plugins/with-android-config-changes"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c7100d6f-ab0a-44be-ba3e-a328e4388642"
      }
    },
    "backgroundColor": "#F7F2EC",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c7100d6f-ab0a-44be-ba3e-a328e4388642"
    }
  }
}
